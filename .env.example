# Which model to use. Options: gemini | groq | openrouter | openai | ollama | custom
LLM_PROVIDER=gemini
# Optional model override (default per provider is in core/llm.py)
# LLM_MODEL=gemini-3.5-flash   (fast; gemini-3.8-flash / gemini-flash-latest are much slower thinking models)

GEMINI_API_KEY=        # free: https://aistudio.google.com/apikey
GROQ_API_KEY=          # free: https://console.groq.com/keys
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# custom = any OpenAI-compatible endpoint (e.g. one Kuku provides)
# LLM_BASE_URL=https://.../v1
# LLM_API_KEY=
# LLM_VISION_MODEL=
