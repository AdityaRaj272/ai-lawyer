# Copy to .streamlit/secrets.toml (git-ignored) to turn on "Sign in with Google".
# If this file is missing or incomplete, the app runs in guest mode (no sign-in, local storage).

[auth]
# Local: http://localhost:8501/oauth2callback
# Streamlit Cloud: https://<your-app>.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = ""
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
